{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "webbmuster.com.au" }],
      "destination": "/marketing"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.webbmuster.com.au" }],
      "destination": "/marketing"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
